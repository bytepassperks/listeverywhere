# Database
DATABASE_URL=postgresql://user:password@localhost:5432/listeverywhere

# Redis
REDIS_URL=redis://localhost:6379

# Firecrawl
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxx

# AI (PageGrid / Anthropic-compatible)
AI_API_KEY=sk-pgrid-xxxxxxxxxxxxxxxxxxxx
AI_API_BASE_URL=https://api.pagegrid.in
AI_MODEL=claude-opus-4-6

# JWT
JWT_SECRET=your-jwt-secret-here

# App
PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Screenshots
SCREENSHOTS_DIR=./screenshots

# Proxy (optional)
# PROXY_POOL_URL=http://proxy-service:8080
