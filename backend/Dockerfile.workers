FROM node:22-slim

WORKDIR /app

# Install system Chromium + fonts (puppeteer-core uses this, no extra download)
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    fonts-liberation \
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libxkbcommon0 \
    libgbm1 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

COPY package*.json ./

# puppeteer-core doesn't download Chromium, so npm install is fast
RUN npm install --include=dev

COPY . .

RUN npm run build

CMD ["node", "dist/workers/index.js"]
